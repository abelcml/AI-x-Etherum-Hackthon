# HSK hackathon profile. Copy to .env.local; fill blanks locally, never commit keys.
HSK_HACKATHON_MODE=true
# The one repository the GitHub App is installed on (owner/repo).
HSK_GITHUB_REPOSITORY=
# Numeric GitHub App id shown on the trusted check_suite webhook payload.
HSK_REQUIRED_CHECK_SUITE_APP_ID=
# Exact required Check Run names from this app, comma separated (for example: unit,lint).
HSK_REQUIRED_CHECK_NAMES=
ONCHAIN_CHAIN=hsk-testnet
ONCHAIN_RPC_URL=https://testnet.hsk.xyz
AGENT_ACCOUNT_MODE=eoa
DATABASE_URL=
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=
API_KEY_ENCRYPTION_SECRET=
ADMIN_EMAIL=
AGENT_OWNER_PRIVATE_KEY=
ORACLE_PRIVATE_KEY=
USDC_ADDRESS=
CREDIT_REGISTRY_ADDRESS=
LABOR_MARKET_ADDRESS=
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_APP_SLUG=
CRON_SECRET=
# Optional platform planning/grading. A coding worker needs its own configuration.
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_MODEL=
# Deployment only. Do not set DEPLOYER_PRIVATE_KEY in the hosted web application.
DEPLOYER_PRIVATE_KEY=
ORACLE_ADDRESS=
ARBITER_ADDRESS=
